# ===== Alamat dan kunci gateway Go (HANYA dipakai di server Next.js) =====
GATEWAY_URL=http://localhost:8080
GATEWAY_KEY=

# ===== Sesi =====
# Wajib, minimal 32 karakter acak:  openssl rand -base64 48
SESSION_SECRET=

# ===== Admin pertama (dibuat otomatis saat login pertama dengan email+sandi ini) =====
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 1 = pendaftaran pengguna terbuka, 0 = hanya admin yang boleh menambah pengguna
ALLOW_SIGNUP=1

# Batas pesan per pengguna per menit
RATE_LIMIT_CHAT_PER_MIN=20

# Penyimpanan pengguna. Kosong = berkas lokal .data/store.json (hanya untuk satu server).
# Untuk Vercel/Netlify WAJIB diisi (Upstash Redis REST):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 1 = teruskan IP pengguna ke gateway lewat X-Forwarded-For (gateway: TRUST_PROXY=1)
FORWARD_CLIENT_IP=0
